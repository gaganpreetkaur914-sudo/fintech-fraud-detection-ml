      "source": [
        "## 2. Data Creation"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "ce13bae4"
      },
      "source": [
        "Since real-world transaction data is sensitive and not publicly available, we will create a synthetic dataset that mimics the characteristics of actual financial transactions, including both legitimate and fraudulent activities. This dataset will incorporate features relevant to fraud detection, as specified in the problem statement."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6b8dc268",
        "outputId": "734ada7b-0668-4188-f856-1e33d5c7f60d"
      },
      "source": [
        "def create_synthetic_data(num_samples=100000):\n",
        "    np.random.seed(42)\n",
        "\n",
        "    data = {\n",
        "        'transaction_amount': np.random.normal(loc=100, scale=70, size=num_samples).astype(int).clip(min=1),\n",
        "        'transaction_time_seconds': np.random.randint(0, 86400 * 30, size=num_samples), # Up to 30 days of transactions\n",
        "        'failed_attempts': np.random.randint(0, 5, size=num_samples),\n",
        "        'account_age_days': np.random.randint(0, 365 * 5, size=num_samples), # Up to 5 years\n",
        "        'location_distance_km': np.random.normal(loc=10, scale=15, size=num_samples).clip(min=0),\n",
        "        'device_changes_30d': np.random.randint(0, 4, size=num_samples),\n",
        "        'is_new_device': np.random.choice([0, 1], size=num_samples, p=[0.95, 0.05]),\n",
        "        'is_international': np.random.choice([0, 1], size=num_samples, p=[0.9, 0.1]),\n",
        "        'ip_address_changed': np.random.choice([0, 1], size=num_samples, p=[0.85, 0.15])\n",
        "    }\n",
        "\n",
        "    df = pd.DataFrame(data)\n",
        "\n",
        "    # Introduce a small percentage of fraudulent transactions (e.g., 1%)\n",
        "    num_fraud = int(num_samples * 0.01)\n",
        "    fraud_indices = np.random.choice(df.index, num_fraud, replace=False)\n",
        "\n",
        "    df['is_fraud'] = 0\n",
        "    df.loc[fraud_indices, 'is_fraud'] = 1\n",
        "\n",
        "    # Make fraudulent transactions more distinct\n",
        "    # Higher amounts, more failed attempts, new device, international, large distance, recent device changes\n",
        "    df.loc[df['is_fraud'] == 1, 'transaction_amount'] = np.random.normal(loc=500, scale=200, size=num_fraud).astype(int).clip(min=50)\n",
        "    df.loc[df['is_fraud'] == 1, 'failed_attempts'] = np.random.randint(1, 5, size=num_fraud)\n",
        "    df.loc[df['is_fraud'] == 1, 'is_new_device'] = np.random.choice([0, 1], size=num_fraud, p=[0.2, 0.8])\n",
        "    df.loc[df['is_fraud'] == 1, 'is_international'] = np.random.choice([0, 1], size=num_fraud, p=[0.3, 0.7])\n",
        "    df.loc[df['is_fraud'] == 1, 'location_distance_km'] = np.random.normal(loc=100, scale=50, size=num_fraud).clip(min=10)\n",
        "    df.loc[df['is_fraud'] == 1, 'device_changes_30d'] = np.random.randint(1, 4, size=num_fraud)\n",
        "    df.loc[df['is_fraud'] == 1, 'ip_address_changed'] = np.random.choice([0, 1], size=num_fraud, p=[0.1, 0.9])\n",
        "\n",
        "    # Ensure some outliers in transaction time for fraud\n",
        "    df.loc[df['is_fraud'] == 1, 'transaction_time_seconds'] = np.random.randint(0, 86400 * 30, size=num_fraud)\n",
        "\n",
        "    print(f\"Generated {num_samples} samples with {df['is_fraud'].sum()} fraudulent transactions.\")\n",
        "    return df\n",
        "\n",
        "# Generate the dataset\n",
        "df = create_synthetic_data(num_samples=200000)\n",
        "\n",
        "# Display the first few rows and basic info\n",
        "print(\"\\nDataset head:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nDataset info:\")\n",
        "print(df.info())\n",
        "\n",
        "print(\"\\nFraud distribution:\")\n",
        "print(df['is_fraud'].value_counts(normalize=True))"
      ],
